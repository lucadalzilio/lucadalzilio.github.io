               <rdf:li rdf:parseType="Resource">
                  <pdfaSchema:namespaceURI>http://ns.adobe.com/xap/1.0/t/pg/</pdfaSchema:namespaceURI>
                  <pdfaSchema:prefix>xmpTPg</pdfaSchema:prefix>
